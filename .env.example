# Firebase web app configuration (Project settings → General → Your apps)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Optional. true = use the explicit browser-local demo backend (never for production).
VITE_DEMO_MODE=false

# Optional. Point the dev server at Firebase Auth (9099) and Realtime Database (9000)
# emulators started by `npm run emulators`. Set VITE_FIREBASE_PROJECT_ID to
# demo-braincircle so the browser and emulators use the same namespace.
VITE_USE_FIREBASE_EMULATORS=false
# Optional overrides if your emulator ports differ.
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# VITE_FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1
# VITE_FIREBASE_DATABASE_EMULATOR_PORT=9000
